##############################################################################
# ROBLOX LIMITED SNIPER v3 — config
#
# Kopyahin ito sa `.env` at punan. Lahat ng key ay may default (nasa baba),
# kaya pwedeng blanko ang hindi mo kailangan. Magbabala ang startup kung may
# mahalagang key na hindi naka-set.
##############################################################################

# ── AUTH (required) ────────────────────────────────────────────────────────
# Ang .ROBLOSECURITY cookie value LANG (walang ".ROBLOSECURITY=" prefix).
# Huwag i-commit. Naka-gitignore na ang .env.
ROBLOSECURITY=

# Discord webhook para sa snipe + deal alerts. Blanko = naka-off ang alerts.
WEBHOOK_URL=

# ── MODE ──────────────────────────────────────────────────────────────────
# true = tumatakbo ang buong pipeline pero HINDI tumatawag sa purchase
# endpoint. Nilo-log kung ano sana ang binili at gaano kabilis. Gamitin ito
# muna. Pwede rin: `npm run dry`
DRY_RUN=false

# ── BUY RULES ─────────────────────────────────────────────────────────────
# Pinakamataas na babayaran kada item, sa Robux.
MAX_PRICE=22

# Tumanggi maliban kung ang Rolimons value (o RAP kung walang value) ay
# lumagpas sa presyo ng ganitong porsyento. 15 = kailangan 15% na kita.
# Ito ang pumalit sa MIN_AVG_GAP — absolute R$ ang luma (1000), kaya
# imposible sa MAX_PRICE=22. Percentage-based na ngayon.
MIN_PROFIT_PCT=15

# Hard ceiling sa kabuuang gastos kada 24h. 0 = walang cap.
# TIP: sa unang armed run, itakda ito sa MAX_PRICE para isang item lang.
DAILY_SPEND_CAP=0

# Huwag bilhin ang items na naka-flag na "projected" sa Rolimons
# (artipisyal na mataas ang presyo — mukhang deal pero hindi).
SKIP_PROJECTED=true

# Pinakamababang Rolimons value para pagtuunan ng pansin. Sinasala ang basura.
MIN_ITEM_VALUE=100

# ── WATCHLIST LANE (ang bilis) ────────────────────────────────────────────
# Mga high-value item na binabantayan ang presyo. Kinukuha ang presyo sa
# pamamagitan ng catalog batch details — 120 asset ids kada request. Nasukat:
# 115 items sa iisang 838ms na tawag. Kaya ang 240-item watchlist ay 2
# requests kada sweep, hindi 240.
#
# (Ang orihinal na disenyo ay per-item resellers polling. Tinanggal: nag-429
# ang endpoint na iyon kahit sa 0.22 rps — isang request kada 4.5 segundo —
# kaya may per-account quota ito, hindi rate limit. Tinatawag na lang ito
# kapag may presyong mukhang mabibili.)
WATCHLIST_SIZE=240

# Layo ng bawat price sweep.
WATCHLIST_INTERVAL_MS=1500

# Ilang resellers lookup kada sweep. Ito ang mahal na resource kaya may
# hiwalay na budget. Taasan lang kung hindi ka na-ra-rate-limit.
WATCHLIST_FOLLOW_UPS=3

# Gaano kadalas muling piliin ang binabantayang items mula sa Rolimons.
WATCHLIST_REBUILD_MS=1800000

# Mga assetId na laging babantayan, anuman ang ranking. Comma-separated.
WATCH_IDS=

# ── DISCOVERY LANE (ang coverage) ─────────────────────────────────────────
# Gaano kadalas i-sweep ang catalog para sa bagong listings.
DISCOVERY_INTERVAL_MS=2500

# Kapag walang nahanap na bago, ito ang mas mahabang pahinga.
DISCOVERY_IDLE_MS=4000

# Items kada discovery tick na ipapasa sa resellers check.
DISCOVERY_BATCH=6

# Items kada catalog search page (max 120 sa Roblox).
CATALOG_LIMIT=120

# IDs kada batch details request (max 120). Mas mataas = mas kaunting RTT.
DETAILS_BATCH=120

# WALANG LAMAN = lahat ng creator (tama para sa UGC limiteds).
# Ang lumang code ay naka-hardcode sa "roblox", na SINASALA ang lahat ng UGC
# limited — user-made ang mga iyon. Huwag punan maliban kung Roblox-made
# items lang ang gusto mo.
CATALOG_CREATOR=

# ── CONCURRENCY ───────────────────────────────────────────────────────────
MAX_CONCURRENT_SNIPES=4

# ── DEAL ALERTS (webhook lang, hindi bumibili) ────────────────────────────
ALERT_ENABLED=true
# Ipagbigay-alam ang anumang listing na ganito karaming % off sa value.
ALERT_DISCOUNT_PCT=40
# 0 = walang price cap sa alerts (nakikita mo pa rin ang mga mahal na deal).
ALERT_MAX_PRICE=0
# Ignore ang items na mababa ang value — maingay.
ALERT_MIN_VALUE=50
# Huwag i-realert ang parehong item sa loob nito (ms). 6h default.
ALERT_TTL=21600000

# ── VALUATION ─────────────────────────────────────────────────────────────
# Rolimons bulk feed: 1 request kada minuto = RAP + value + demand +
# projected flag para sa LAHAT ng limiteds. Pinapalitan nito ang libo-libong
# per-item resale-data call na `null` na pala para sa collectibles.
ROLIMONS_ENABLED=true
ROLIMONS_REFRESH_MS=300000

# ── RATE LIMITING ─────────────────────────────────────────────────────────
# NASUKAT ito, hindi hula. Isang calibration run laban sa live
# marketplace-sales resellers endpoint: malinis hanggang 4 rps, nagsimulang
# mag-429 sa 6 rps (22 sa loob ng 6s). Nasa ilalim lang ng observed limit ang
# defaults; ang AIMD limiter na ang mag-a-adjust pataas.
#
# Nag-a-adapt ito sa runtime: bumababa sa 429 at bumababa rin ang ceiling
# (parang TCP ssthresh), kaya hindi na siya bumabalik sa rate na alam nang
# bumabagsak. Panimulang punto lang ito, hindi hard limit.
RPS_CATALOG=2.5
RPS_ECONOMY=6
RPS_MARKETPLACE=3.5

# ── FILES ─────────────────────────────────────────────────────────────────
STATE_FILE=sniper_state.json
LOG_FILE=sniper.log
# Machine-readable audit trail (isang JSON object kada linya). Blanko = off.
JSONL_FILE=sniper.jsonl
LOG_LEVEL=info

# ── PROXY (optional, naka-off by default) ─────────────────────────────────
# Comma-separated na http proxy URLs. Blanko = direktang koneksyon.
# Halimbawa: http://user:pass@host:port,http://host2:port
PROXY_LIST=
